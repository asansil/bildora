{
  "name": "@bildora/desktop",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Electron main process, preload and React renderer.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "package": "electron-builder --win zip --publish never"
  },
  "dependencies": {
    "@bildora/cli": "workspace:*",
    "@bildora/core": "workspace:*",
    "@bildora/protocol": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bildora/typescript-config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "catalog:",
    "electron-builder": "26.18.0",
    "electron-vite": "catalog:",
    "lucide-react": "^1.69.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "author": "Bildora",
  "build": {
    "appId": "dev.bildora.app",
    "productName": "Bildora",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "extraFiles": [
      {
        "from": "packaging/bildora.cmd",
        "to": "bildora.cmd"
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node-pty/prebuilds/**",
      "**/node-pty/lib/**",
      "**/job-launcher.exe"
    ],
    "win": {
      "target": [
        "zip"
      ]
    },
    "artifactName": "${productName}-${version}-win-${arch}.${ext}"
  }
}
