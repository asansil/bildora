{
  "name": "@bildora/core",
  "version": "0.0.0",
  "private": true,
  "description": "Headless domain logic, with no Electron dependency.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-launcher.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bildora/protocol": "workspace:*",
    "@napi-rs/keyring": "^2.1.2",
    "@xterm/headless": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "node-pty": "1.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@bildora/typescript-config": "workspace:*",
    "@types/better-sqlite3": "^9.6.0"
  }
}
