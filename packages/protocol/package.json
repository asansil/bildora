{
  "name": "@bildora/protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Tool protocol types and JSON Schemas shared by every consumer.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/tool-manifest.schema.json": "./dist/schemas/tool-manifest.schema.json",
    "./schemas/automation.schema.json": "./dist/schemas/automation.schema.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/generate-schemas.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@bildora/typescript-config": "workspace:*",
    "ajv": "^8.20.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
