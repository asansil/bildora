{
  "name": "@bildora/panel-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Panel UI kit, theme tokens and bridge to Bildora.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./theme/tokens.css"
  },
  "files": [
    "dist",
    "theme"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@bildora/typescript-config": "workspace:*"
  }
}
